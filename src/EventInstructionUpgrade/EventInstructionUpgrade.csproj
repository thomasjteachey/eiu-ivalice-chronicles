<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Event Instruction Upgrade for The Ivalice Chronicles (enhanced): Xifanie's PS1 event
    hack (as The Lion War ReMixed uses it) run in the remaster, as its own Reloaded-II mod.
    Mods whose events use it (Ivalice ReMixed) depend on it and reach it through
    EventInstructionUpgrade.Interfaces. build.py (at the repo's root) builds it into its mod folder.

    Reloaded-II supplies Reloaded.Mod.Interfaces, and the shared hooks mod
    (reloaded.sharedlib.hooks) the Reloaded.Hooks interfaces, so they're referenced from
    your Reloaded-II install and not copied. build.py passes ReloadedDir and
    ReloadedModsDir.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>EventInstructionUpgrade</AssemblyName>
    <RootNamespace>EventInstructionUpgrade</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ReloadedDir Condition="'$(ReloadedDir)' == ''">$(RELOADEDII)</ReloadedDir>
    <ReloadedModsDir Condition="'$(ReloadedModsDir)' == ''">$(ReloadedDir)\Mods</ReloadedModsDir>
    <HooksDir>$(ReloadedModsDir)\reloaded.sharedlib.hooks\x64</HooksDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Reloaded.Mod.Interfaces">
      <HintPath>$(ReloadedDir)\Loader\X64\Reloaded.Mod.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Reloaded.Hooks.Definitions">
      <HintPath>$(HooksDir)\Reloaded.Hooks.Definitions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Reloaded.Hooks.ReloadedII.Interfaces">
      <HintPath>$(HooksDir)\Reloaded.Hooks.ReloadedII.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IvaliceCore\IvaliceCore.csproj" />
    <ProjectReference Include="..\EventInstructionUpgrade.Interfaces\EventInstructionUpgrade.Interfaces.csproj" />
    <Using Include="IvaliceCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- The offline checks: this repo's, and Ivalice ReMixed's, which tests the upgrade with its own events. -->
    <InternalsVisibleTo Include="EventInstructionUpgrade.Check" />
    <InternalsVisibleTo Include="IvaliceRemixed.Check" />
  </ItemGroup>

  <Target Name="CheckReloadedDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ReloadedDir)\Loader\X64\Reloaded.Mod.Interfaces.dll')"
           Text="Set ReloadedDir to your Reloaded-II folder (build with build.py, or pass -p:ReloadedDir=...)." />
    <Error Condition="!Exists('$(HooksDir)\Reloaded.Hooks.Definitions.dll')"
           Text="Install Reloaded-II's shared hooks mod (reloaded.sharedlib.hooks), or pass -p:ReloadedModsDir=..." />
  </Target>

</Project>
